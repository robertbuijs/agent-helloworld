# --- Model ---
# Override if the org pins a specific Gemini model.
AGENT_MODEL=gemini-flash-latest

# --- GCP / Agent Runtime deploy ---
# Also accepted as GCP_PROJECT / LOCATION / STAGING_BUCKET.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=gs://your-agent-staging-bucket
# Optional aliases used by scripts/deploy_agent_runtime.py:
# GCP_PROJECT=
# LOCATION=
# STAGING_BUCKET=gs://your-agent-staging-bucket

# Display metadata written onto the reasoningEngine resource.
AGENT_DISPLAY_NAME=Enterprise Assistant
AGENT_DESCRIPTION=Read-only Jira and GitHub assistant for Gemini Enterprise (Phase 1).

# Optional GCS subdir under the staging bucket (avoids clobbering other deploys).
# GCS_DIR_NAME=enterprise-assistant

# --- GitHub MCP (HTTP, Runtime-friendly) ---
# Fine-grained or classic PAT with read access to target orgs/repos.
GITHUB_TOKEN=
# Alias also accepted:
# GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOOLSETS=repos,issues,pull_requests

# --- Atlassian / Jira MCP ---
# Preferred for Agent Runtime: HTTP + API token or service-account API key.
# Org admin must enable API-token auth on Rovo MCP server settings.
ATLASSIAN_MCP_TRANSPORT=http
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp

# Option A — ready-made Authorization header (Basic … or Bearer …):
# ATLASSIAN_MCP_AUTH_HEADER=Basic base64(email:api_token)

# Option B — service account API key (Bearer):
# ATLASSIAN_API_KEY=

# Option C — personal email + API token (Basic, assembled at runtime):
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_API_TOKEN=

# Local-only interactive OAuth fallback (NOT for Agent Runtime):
# ATLASSIAN_MCP_TRANSPORT=stdio

# --- Secret Manager IDs (deploy injects these as env vars on Runtime) ---
# Leave blank to pass plain env values from this file instead (local/dev only).
SM_GITHUB_TOKEN_SECRET=github-token
SM_GITHUB_TOKEN_VERSION=latest
SM_ATLASSIAN_AUTH_SECRET=atlassian-mcp-auth
SM_ATLASSIAN_AUTH_VERSION=latest
